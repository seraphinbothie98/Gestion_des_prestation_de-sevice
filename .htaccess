# ==============================================================================
# CENTRE MANAGEMENT SYSTEM (CMS) - CPANEL APACHE / LITESPEED CONFIGURATION
# ==============================================================================

DirectoryIndex dist/index.html index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Sécurité : Bloquer l'accès direct aux fichiers et dossiers sensibles
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^database/ - [F,L,NC]
    RewriteRule ^backup/ - [F,L,NC]
    RewriteRule ^server/ - [F,L,NC]
    RewriteRule ^src/ - [F,L,NC]

    # 2. Laisser passer directement les requêtes API vers Node.js / Passenger
    RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
    RewriteRule ^ - [L]

    # 3. Servir les assets compilés depuis dist/ (ex: /assets/..., /logo.png, etc.)
    RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
    RewriteRule ^(.*)$ dist/$1 [L]

    # 4. Si la ressource demandée existe physiquement à la racine (hors index.html racine)
    RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Rediriger la racine / et toutes les routes SPA vers dist/index.html
    RewriteRule ^$ dist/index.html [L]
    RewriteRule ^index\.html$ dist/index.html [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>

# 6. Compression GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# 7. En-têtes de sécurité et Cache
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"

    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|svg)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>
