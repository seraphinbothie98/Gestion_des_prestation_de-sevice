# ==============================================================================
# CENTRE MANAGEMENT SYSTEM (CMS) - CONFIGURATION CPANEL (.env.example)
# Architecture: Frontend React (dist/) -> Backend Node.js (/api) -> PostgreSQL 10.23+
# ==============================================================================

# Environnement de l'application Node.js
NODE_ENV=production
PORT=3000

# Base de données PostgreSQL locale sur cPanel
# (Remplir avec les identifiants créés dans "Bases de données PostgreSQL" sur cPanel)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=votrecompte_cmsdb
DB_USER=votrecompte_cmsuser
DB_PASSWORD=
DB_SSL=false

# Alternative: Chaîne de connexion complète PostgreSQL (facultatif si DB_* est renseigné)
# DATABASE_URL=postgresql://votrecompte_cmsuser:MOT_DE_PASSE@127.0.0.1:5432/votrecompte_cmsdb

# Authentification & Sessions (Obligatoire: chaîne aléatoire secrète de minimum 32 caractères)
JWT_SECRET=remplacer_par_une_cle_secrete_aleatoire_de_minimum_32_caracteres
SESSION_EXPIRY=7d

# Stockage des fichiers sur cPanel
STORAGE_PROVIDER=local
STORAGE_DIR=storage/uploads

# Configuration des passerelles de paiement (si utilisées)
PAYMENT_DEFAULT_CURRENCY=GNF
PAYMENT_ORANGE_MONEY_API_KEY=
PAYMENT_MTN_MOMO_API_KEY=

# Notifications Email SMTP standard cPanel
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=mail.votredomaine.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=contact@votredomaine.com
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=contact@votredomaine.com

# Notifications SMS & WhatsApp (facultatif)
SMS_PROVIDER=custom
SMS_API_KEY=
SMS_SENDER_ID=CMS-CENTRE
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
